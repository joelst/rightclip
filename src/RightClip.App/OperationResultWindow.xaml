<Window x:Class="RightClip.App.OperationResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightClip result" Width="600" SizeToContent="Height" MaxHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ResultTitle" FontSize="24" FontWeight="SemiBold" AutomationProperties.AutomationId="OperationResultTitle" />
        <TextBlock x:Name="ResultSummary" Grid.Row="1" Margin="0,8,0,14" TextWrapping="Wrap"
                   AutomationProperties.AutomationId="OperationResultSummary" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="Outputs" AutomationProperties.AutomationId="OperationResultOutputs" />
                <ItemsControl x:Name="Failures" AutomationProperties.AutomationId="OperationResultFailures" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Open output folder" Click="OpenOutputClick" />
            <Button Content="Close" Click="CloseClick" AutomationProperties.AutomationId="OperationResultClose" />
        </StackPanel>
    </Grid>
</Window>
