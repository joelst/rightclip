<Window x:Class="RightClip.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightClip preview" MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding PreviewTime}" Foreground="#52616C" Padding="12,8" HorizontalAlignment="Right"
                   AutomationProperties.AutomationId="DetachedPreviewTime" />
        <Grid Grid.Row="1" Background="#101820">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" AutomationProperties.AutomationId="DetachedPreviewImage" />
            <TextBlock Text="{Binding PreviewStatus}" Foreground="White" Background="#99000000" Padding="9,5"
                       VerticalAlignment="Bottom" TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Window>
