<UserControl x:Class="RightClip.App.TrimTimelineControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="160"
             AutomationProperties.Name="Timeline context menu"
             AutomationProperties.AutomationId="TimelineContextMenu">
    <UserControl.Resources>
        <ControlTemplate x:Key="CutMarkTemplate" TargetType="Thumb">
            <Grid Width="18" Height="106" Background="Transparent">
                <Border Width="2" Background="{TemplateBinding Background}" HorizontalAlignment="Center" />
                <Border Width="16" Height="16" CornerRadius="4" Background="{TemplateBinding Background}" VerticalAlignment="Top">
                    <TextBlock Text="{TemplateBinding Tag}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </ControlTemplate>
        <Style x:Key="ClipStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#EDF1F4" />
            <Setter Property="Foreground" Value="#586774" />
            <Setter Property="BorderBrush" Value="#D9E0E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="4"
                                Margin="2,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#176B87" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#176B87" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FFB447" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Left" PreviewMouseWheel="ViewportMouseWheel">
    <Grid x:Name="Surface" SizeChanged="SurfaceSizeChanged" PreviewMouseRightButtonDown="TimelineRightButtonDown"
          ContextMenuOpening="TimelineContextMenuOpening">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem x:Name="AddContextCut" Header="Add cut here" Click="AddContextCutClick"
                          AutomationProperties.AutomationId="AddTimelineContextCut" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="42" />
            <RowDefinition Height="24" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Border Background="#17232D" CornerRadius="6" ClipToBounds="True" MouseLeftButtonDown="FilmstripMouseDown">
            <UniformGrid x:Name="Filmstrip" Rows="1" AutomationProperties.AutomationId="TimelineFilmstrip" />
        </Border>
        <Canvas x:Name="ExcludedRegions" IsHitTestVisible="False" />
        <Canvas x:Name="Clips" Grid.Row="1" />
        <Canvas x:Name="Marks" Grid.RowSpan="2" />
        <Canvas Grid.RowSpan="2" IsHitTestVisible="False">
            <Line x:Name="Playhead" Y1="0" Y2="106" Stroke="#FFB447" StrokeThickness="2" />
        </Canvas>
        <Canvas x:Name="Ruler" Grid.Row="2" IsHitTestVisible="False" />
        <Slider x:Name="PlayheadSlider" Grid.Row="3" Minimum="0" SmallChange="0.04" LargeChange="1"
                AutomationProperties.Name="Timeline position" AutomationProperties.AutomationId="TimelinePosition"
                ValueChanged="PlayheadValueChanged" Margin="0,2" />
    </Grid>
    </ScrollViewer>
</UserControl>
