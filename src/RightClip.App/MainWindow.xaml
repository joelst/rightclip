<Window x:Class="RightClip.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RightClip.App"
        Title="RightClip" Width="1080" Height="790" MinWidth="850" MinHeight="700"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="WindowDrop" DragOver="WindowDragOver" Closing="WindowClosing" SizeChanged="WindowSizeChanged">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="SemiBold" Text="RightClip" />
                <TextBlock Foreground="#52616C" Text="Your video. Your cuts. Originals stay unchanged."
                           Visibility="{Binding ShowTimelineHints, Converter={StaticResource BooleanVisibilityConverter}}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Settings" Click="SettingsClick" VerticalAlignment="Top" />
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#D9E0E5" BorderThickness="1" CornerRadius="9" Padding="12"
                IsEnabled="{Binding CanChangeFiles}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" DisplayMemberPath="FileName"
                                  AutomationProperties.Name="Active video" AutomationProperties.AutomationId="ActiveVideoSelection"
                                  MaxWidth="620" HorizontalAlignment="Left" MinWidth="300">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <TextBlock Text="{Binding SelectedFile.Status}" Foreground="#52616C" Margin="2,5,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFile.Status}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Remove" Click="RemoveClick" Padding="10,4" />
                        <Button Content="Add videos" Click="AddClick" Padding="10,4" />
                    </StackPanel>
                </Grid>
                <Expander Grid.Row="1" Header="{Binding VideoCountLabel}" Margin="2,7,0,0"
                          Visibility="{Binding HasMultipleVideos, Converter={StaticResource BooleanVisibilityConverter}}">
                <DataGrid x:Name="FilesGrid" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False"
                          Height="110"
                          CanUserAddRows="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Video" Binding="{Binding FileName}" Width="2*" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" />
                        <DataGridTemplateColumn Header="Progress" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ProgressBar Value="{Binding Progress}" Maximum="1" MinHeight="10" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                </Expander>
                <StackPanel Grid.Row="2" Margin="2,6,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanVisibilityConverter}}"
                            AutomationProperties.AutomationId="LoadingIndicator">
                    <TextBlock Text="{Binding LoadingStatus}" Foreground="#52616C" Margin="0,0,0,4"
                               AutomationProperties.AutomationId="LoadingIndicatorText" />
                    <ProgressBar Height="5" IsIndeterminate="True" />
                </StackPanel>
            </Grid>
        </Border>
        <TabControl Grid.Row="2" Margin="0,14,0,10" SelectedIndex="{Binding SelectedActionIndex}" Background="White" BorderBrush="#D9E0E5"
                    AutomationProperties.AutomationId="TrimTabs">
            <TabItem Header="Trim">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,5" LastChildFill="False">
                                <TextBlock Text="Preview" Foreground="#52616C" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Click="PopOutPreviewClick" ToolTip="Pop out preview" Padding="10,3"
                                        AutomationProperties.Name="Pop out preview" AutomationProperties.AutomationId="PopOutPreview">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8A7;" />
                                </Button>
                            </DockPanel>
                            <Border x:Name="InlinePreviewFrame" Height="{Binding PreviewHeight}" Width="{Binding PreviewWidth}" MaxWidth="560"
                                    HorizontalAlignment="Center" Background="#101820" CornerRadius="9" Margin="0,0,0,12" ClipToBounds="True"
                                    AutomationProperties.AutomationId="InlinePreviewFrame">
                                <Grid>
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform" AutomationProperties.AutomationId="InlinePreviewImage" />
                                    <DockPanel VerticalAlignment="Top" Background="#99000000" Margin="0">
                                        <TextBlock Text="{Binding SelectedFile.FileName}" Foreground="White" Padding="9,5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PlayheadTime}" Foreground="White" Padding="9,5" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding PreviewStatus}" Foreground="White" Background="#99000000" Padding="9,5"
                                               VerticalAlignment="Bottom" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <local:TrimTimelineControl x:Name="Timeline" Grid.Row="1" Segments="{Binding TimelineSegments}" Thumbnails="{Binding TimelineThumbnails}"
                                                   Position="{Binding PlayheadSeconds, Mode=TwoWay}" SelectedCut="{Binding SelectedCutSeconds}"
                                                   IsEnabled="{Binding CanEditTimeline}"
                                                   CutAdded="TimelineCutAdded" CutMoved="TimelineCutMoved" CutRemoved="TimelineCutRemoved"
                                                   CutSelected="TimelineCutSelected" SegmentToggled="TimelineSegmentToggled" />
                        <DockPanel Grid.Row="2" Margin="0,5,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button Command="{Binding AddCutCommand}" ToolTip="Add cut" Padding="11,8"
                                        AutomationProperties.Name="Add cut" AutomationProperties.AutomationId="AddTimelineCut">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8C6;" />
                                </Button>
                                <Button Command="{Binding RemoveCutCommand}" ToolTip="Remove selected cut" Padding="11,8"
                                        AutomationProperties.Name="Remove cut" AutomationProperties.AutomationId="RemoveTimelineCut">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE74D;" />
                                </Button>
                                <Button Command="{Binding ResetCutsCommand}" ToolTip="Reset cuts" Padding="11,8"
                                        AutomationProperties.Name="Reset cuts" AutomationProperties.AutomationId="ResetTimelineCuts">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE72C;" />
                                </Button>
                                <Button Click="TimelineZoomOutClick" ToolTip="Zoom out" Padding="11,8"
                                        AutomationProperties.Name="Zoom out" AutomationProperties.AutomationId="TimelineZoomOut">
                                    <TextBlock FontSize="18" Text="−" />
                                </Button>
                                <Button Click="TimelineZoomInClick" ToolTip="Zoom in" Padding="11,8"
                                        AutomationProperties.Name="Zoom in" AutomationProperties.AutomationId="TimelineZoomIn">
                                    <TextBlock FontSize="18" Text="+" />
                                </Button>
                                <Button Click="TimelineFitClick" ToolTip="Fit full video" Padding="11,8"
                                        AutomationProperties.Name="Fit full video" AutomationProperties.AutomationId="TimelineFit">
                                    <TextBlock FontSize="16" Text="⌂" />
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding TimelinePreviewStatus}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Foreground="#52616C" FontSize="11" />
                        </DockPanel>
                        <StackPanel Grid.Row="3">
                        <TextBlock Text="Right-click or double-click to cut · drag marks to move · click clips to include or exclude"
                                   Foreground="#52616C" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Visibility="{Binding ShowTimelineHints, Converter={StaticResource BooleanVisibilityConverter}}" />
                        <TextBlock Text="{Binding TimelineSummary}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding OutputHint}" Foreground="#52616C" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   ToolTip="{Binding OutputHint}"
                                   Visibility="{Binding ShowTimelineHints, Converter={StaticResource BooleanVisibilityConverter}}" />
                        </StackPanel>
                        <Expander Grid.Row="4" Header="Advanced · encoding, batch trimming, and scene splitting" Margin="0,10,0,0"
                                  VerticalAlignment="Top"
                                  AutomationProperties.AutomationId="AdvancedTrimOptions"
                                  IsEnabled="{Binding CanChangeFiles}">
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,12,0,4">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cut mode" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedCutEncodingIndex}"
                                      AutomationProperties.AutomationId="CutEncoding" AutomationProperties.Name="Cut mode">
                                <ComboBoxItem Content="Keyframe-safe (re-encode video)" />
                                <ComboBoxItem Content="Fast stream copy" />
                            </ComboBox>
                        </Grid>
                        <TextBlock Margin="0,0,0,14" Foreground="#52616C" TextWrapping="Wrap"
                                   Text="Accurate cuts are the default. Fast copy reviews landed keyframes before export. The tools below apply to all listed videos; timeline cut marks apply only to the active video." />
                        <TextBlock Text="{Binding CutEncodingSummary}" Foreground="#52616C" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="Operation" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <ComboBox SelectedIndex="{Binding SelectedTrimModeIndex}"
                                          AutomationProperties.AutomationId="TrimMode" AutomationProperties.Name="Operation">
                                    <ComboBoxItem Content="Trim the start" />
                                    <ComboBoxItem Content="Trim the end" />
                                    <ComboBoxItem Content="Keep a range" />
                                    <ComboBoxItem Content="Split on scene changes" />
                                </ComboBox>
                                <TextBlock Text="Time entry" FontWeight="SemiBold" Margin="0,14,0,5" />
                                <ComboBox SelectedIndex="{Binding SelectedTimeKindIndex}" IsEnabled="{Binding IsTimeKindEnabled}">
                                    <ComboBoxItem Content="Duration offset (each file)" />
                                    <ComboBoxItem Content="Clock time (same position)" />
                                </ComboBox>
                                <TextBlock Margin="0,14,0,5" FontWeight="SemiBold" Text="Scene sensitivity" />
                                <Slider Value="{Binding SceneSensitivity}" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                        IsEnabled="{Binding IsSceneMode}" />
                                <TextBlock Text="{Binding SceneSensitivity, StringFormat={}{0} / 100}" Foreground="#52616C" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding StartLabel}" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <TextBox Text="{Binding StartInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsStartInputEnabled}"
                                         AutomationProperties.AutomationId="TrimStartInput" AutomationProperties.Name="{Binding StartLabel}" />
                                <TextBlock Text="{Binding EndLabel}" FontWeight="SemiBold" Margin="0,14,0,5" />
                                <TextBox Text="{Binding EndInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEndInputEnabled}"
                                         AutomationProperties.AutomationId="TrimEndInput" AutomationProperties.Name="{Binding EndLabel}" />
                                <TextBlock Margin="0,14,0,0" Foreground="#52616C" TextWrapping="Wrap"
                                           Text="Use seconds, MM:SS, or HH:MM:SS. Batch clock times must fit every listed video." />
                            </StackPanel>
                        </Grid>
                        <Button Content="Review batch / scene operation" Command="{Binding ReviewCommand}" HorizontalAlignment="Right" Margin="0,12,0,0"
                                AutomationProperties.AutomationId="BatchOperationReview" />
                        </StackPanel>
                        </ScrollViewer>
                        </Expander>
                    </Grid>
            </TabItem>
            <TabItem Header="Tracks">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="115" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Audio tracks and soft subtitles" />
                        <CheckBox Content="Extract selected soft subtitles instead of remuxing" IsChecked="{Binding ExtractSelectedSubtitles}" Margin="0,8,0,0" />
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TrackRows}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Keep / extract" Binding="{Binding Keep, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                            <DataGridTextColumn Header="Track (batch uses this track number)" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="New title (blank clears)" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,12,0,5">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Add soft subtitles" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Remove" Click="RemoveSubtitleClick" Padding="10,3" />
                            <Button Content="Add subtitle file" Click="AddSubtitleClick" Padding="10,3" IsEnabled="{Binding CanAddSubtitles}" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="SubtitlesGrid" Grid.Row="3" ItemsSource="{Binding AddedSubtitles}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" IsReadOnly="True" Width="2*" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Language" Binding="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Details">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="105" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel>
                        <CheckBox Content="Fast start (MP4/MOV)" IsChecked="{Binding FastStart}" Margin="0,0,22,10" />
                        <CheckBox Content="Strip location data" IsChecked="{Binding StripLocation}" Margin="0,0,22,10" />
                        <ComboBox SelectedIndex="{Binding SelectedRotationIndex}" MinWidth="160" Margin="0,0,8,10">
                            <ComboBoxItem Content="Rotation unchanged" />
                            <ComboBoxItem Content="Rotate to 0°" />
                            <ComboBoxItem Content="Rotate to 90°" />
                            <ComboBoxItem Content="Rotate to 180°" />
                            <ComboBoxItem Content="Rotate to 270°" />
                        </ComboBox>
                        <Button Content="Add tag" Click="AddTagClick" Padding="10,3" />
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Tags}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Value (blank removes)" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2" Margin="0,12,0,5">
                        <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="Chapters" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Remove" Click="RemoveChapterClick" Padding="10,3" />
                            <Button Content="Add chapter" Click="AddChapterClick" Padding="10,3" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ChaptersGrid" Grid.Row="3" ItemsSource="{Binding Chapters}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding Start, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="End" Binding="{Binding End, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Title" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding BusyStatus}" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="44" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding Summary}" Foreground="#52616C" TextWrapping="Wrap" ToolTip="{Binding Summary}"
                               AutomationProperties.AutomationId="OperationSummary" />
                </ScrollViewer>
            </StackPanel>
            <Button Grid.Column="1" Content="Open last output folder" Click="OpenOutputClick" IsEnabled="{Binding HasOutputs}" />
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="{Binding ExportButtonLabel}" Command="{Binding ExportClipsCommand}"
                    AutomationProperties.AutomationId="ExportTimelineClips"
                    ToolTip="{Binding OutputHint}"
                    Visibility="{Binding IsTrimAction, Converter={StaticResource BooleanVisibilityConverter}}"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
            <Button Content="Review and run" Command="{Binding ReviewCommand}"
                    Visibility="{Binding IsOtherAction, Converter={StaticResource BooleanVisibilityConverter}}"
                    Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold" />
        </StackPanel>
    </Grid>
</Window>
