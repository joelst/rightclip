<Window x:Class="RightClip.App.MetadataRemovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightClip - Remove Metadata" Width="580" SizeToContent="Height" MaxHeight="440"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded" Closing="WindowClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="MetadataRemovalContent">
        <StackPanel Margin="24">
            <TextBlock x:Name="StatusText" Text="Removing metadata" FontSize="20" FontWeight="SemiBold"
                       AutomationProperties.AutomationId="MetadataRemovalStatus" />
            <TextBlock x:Name="CurrentFileText" Foreground="#52616C" TextWrapping="Wrap" Margin="0,8,0,0" />
            <ProgressBar x:Name="OperationProgress" Height="6" IsIndeterminate="True" Maximum="1" Margin="0,16,0,0" />
            <TextBox x:Name="ResultText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                     Padding="0" Margin="0,16,0,0" AutomationProperties.AutomationId="MetadataRemovalResults" />
            <TextBlock Text="Original files stay unchanged." Foreground="#52616C" Margin="0,12,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
