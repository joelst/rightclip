<Window x:Class="RightClip.App.OperationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightClip working" Width="470" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Closing="WindowClosing">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/RightClip.ico" Width="34" Height="34" Margin="0,0,10,0" />
            <TextBlock x:Name="OperationText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="OperationProgressTitle" />
        </StackPanel>
        <TextBlock x:Name="CurrentFileText" Grid.Row="1" Foreground="#52616C" TextWrapping="Wrap" Margin="0,10,0,0"
                   AutomationProperties.AutomationId="OperationProgressFile" />
        <ProgressBar x:Name="Progress" Grid.Row="2" Height="8" Minimum="0" Maximum="1" Margin="0,16,0,0" />
        <TextBlock x:Name="PercentText" Grid.Row="3" HorizontalAlignment="Right" Foreground="#52616C" Margin="0,4,0,0" />
        <CheckBox x:Name="SkipNotification" Grid.Row="4" Content="Skip notification when complete" Margin="0,16,0,0"
                  Checked="SkipChanged" Unchecked="SkipChanged" AutomationProperties.AutomationId="SkipCompletionNotification" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Click="CancelClick" AutomationProperties.AutomationId="CancelOperationProgress" />
            <Button Content="Hide" Click="HideClick" ToolTip="Hide and exit when complete"
                    AutomationProperties.AutomationId="HideOperationProgress" />
        </StackPanel>
    </Grid>
</Window>
