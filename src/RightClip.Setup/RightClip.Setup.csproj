<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>RightClip-Setup</AssemblyName>
    <RootNamespace>RightClip.Setup</RootNamespace>
    <ApplicationIcon>..\..\assets\RightClip.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\RightClip.ico" Link="RightClip.ico" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(PayloadPath)')">
    <EmbeddedResource Include="$(PayloadPath)" LogicalName="RightClip.Payload.zip" Link="RightClip.Payload.zip" />
  </ItemGroup>
</Project>
