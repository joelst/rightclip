<Window x:Class="RightClip.Setup.InstallSuccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RightClip installation complete" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/RightClip.ico" Width="42" Height="42" Margin="0,0,12,0" />
            <TextBlock Text="Install successful!" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                       AutomationProperties.AutomationId="InstallSuccessTitle" />
        </StackPanel>
        <TextBlock x:Name="LocationText" Grid.Row="1" Margin="0,18,0,0" TextWrapping="Wrap" Foreground="#52616C"
                   AutomationProperties.AutomationId="InstallSuccessLocation" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="View log" Click="ViewLogClick" MinHeight="36" Padding="14,0"
                    AutomationProperties.AutomationId="InstallSuccessViewLog" />
            <Button Content="Exit" Click="ExitClick" MinHeight="36" Padding="14,0" Margin="12,0,0,0"
                    Background="#176B87" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    AutomationProperties.AutomationId="InstallSuccessExit" />
        </StackPanel>
    </Grid>
</Window>
